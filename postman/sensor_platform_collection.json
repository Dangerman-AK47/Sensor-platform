{
  "info": {
    "name": "ESP32 Sensor Platform & Admin API Collection",
    "_postman_id": "sensor-platform-v1",
    "description": "Complete API testing collection for ESP32 Sensor Platform: IoT Sensor APIs, Portal Auth, and Admin Dashboard APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://realtimeprojectsolutions.com",
      "type": "string"
    },
    {
      "key": "sensorToken",
      "value": "YOUR_SENSOR_BEARER_TOKEN",
      "type": "string",
      "description": "32-character hex Bearer token returned from /api/v1/sensors/register"
    },
    {
      "key": "deviceId",
      "value": "ESP32-DEVICE-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. IoT Sensor APIs",
      "item": [
        {
          "name": "1. Register Sensor (Auto-Approval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"sensorVersion\": \"1.0.0\",\n  \"firmwareVersion\": \"4.0.0\",\n  \"hardwareModel\": \"ESP32-DevKit-V1\",\n  \"metadata\": {\n    \"location\": \"Testing Lab\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "register"
              ]
            },
            "description": "Registers device. Returns 32-character hex Bearer token immediately."
          }
        },
        {
          "name": "2. Sensor Heartbeat Ping",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sensorToken}}"
              },
              {
                "key": "X-Sensor-ID",
                "value": "{{deviceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"sensorVersion\": \"1.1.1\",\n  \"firmwareVersion\": \"4.0.0\",\n  \"hardwareModel\": \"ESP32-DevKit-V1\",\n  \"metadata\": {\n    \"freeHeap\": 184320,\n    \"rssi\": -55,\n    \"uptime\": 3600\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/heartbeat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "heartbeat"
              ]
            },
            "description": "Sends periodic ping and syncs latest sensor_version to admin website."
          }
        },
        {
          "name": "3. Check Configuration Version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sensorToken}}"
              },
              {
                "key": "X-Sensor-ID",
                "value": "{{deviceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentVersion\": \"1.0.0\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/version-check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "version-check"
              ]
            },
            "description": "Compares reported version against active configuration on server."
          }
        },
        {
          "name": "4. Download Active Configuration",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sensorToken}}"
              },
              {
                "key": "X-Sensor-ID",
                "value": "{{deviceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/configuration/download",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "configuration",
                "download"
              ]
            },
            "description": "Downloads the active JSON configuration and records download audit. Allows multiple repeat downloads unconditionally even if already up to date."
          }
        },
        {
          "name": "5. Check Sensor Code File Version",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sensorToken}}"
              },
              {
                "key": "X-Sensor-ID",
                "value": "{{deviceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"currentVersion\": \"1.0.0\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/code/version-check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "code",
                "version-check"
              ]
            },
            "description": "Checks if an OTA sensor code/firmware update is available on the server. Always returns downloadUrl."
          }
        },
        {
          "name": "6. Download Active Code File",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sensorToken}}"
              },
              {
                "key": "X-Sensor-ID",
                "value": "{{deviceId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/code/download?deviceId={{deviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "code",
                "download"
              ],
              "query": [
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            },
            "description": "Streams active sensor code / firmware file to device. Allows multiple repeat downloads unconditionally even if already up to date."
          }
        },
        {
          "name": "7. Upload Telemetry Data File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sensorToken}}"
              },
              {
                "key": "X-Sensor-ID",
                "value": "{{deviceId}}"
              },
              {
                "key": "X-Sensor-Version",
                "value": "1.1.1"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/sensors/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sensors",
                "upload"
              ]
            },
            "description": "Uploads sensor data file (CSV / binary, max 100MB) with SHA-256 validation."
          }
        }
      ]
    },
