# =====================================================================
# HostyCare Production Environment Configuration (.env)
# =====================================================================

APP_ENV=production
APP_NAME="Sensor Telemetry Platform"
# Set to your live custom domain with https://
APP_URL=https://yourdomain.com

# ---------------------------------------------------------------------
# HostyCare cPanel MySQL Database Settings
# In cPanel, database names and usernames ALWAYS include your cPanel username prefix!
# Example: If your cPanel username is 'hostyuser', the database will be 'hostyuser_sensordb'
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_sensordb
DB_USER=cpaneluser_sensoruser
DB_PASS="ReplaceWithYourHostyCareDatabasePassword"
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------
# Session & Security Settings
# Generate a random 64-character string for production session encryption
# ---------------------------------------------------------------------
SESSION_SECRET="e9b2c3d4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2"
SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------------
# Storage Limits (HostyCare NVMe SSD)
# ---------------------------------------------------------------------
MAX_FILE_SIZE_MB=100
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=storage/uploads
CONFIG_DIR=storage/configs
