# =====================================================================
# Sensor Platform / FileVault / DeviceVault v3 - Environment Configuration
# =====================================================================

# Application Environment: 'development' or 'production'
APP_ENV=development
APP_NAME="Sensor Platform / FileVault"
APP_URL=http://localhost:8000

# Database Configuration (HostyCare cPanel MySQL / MariaDB or Local)
# Note: On HostyCare, DB_NAME and DB_USER typically have your cPanel prefix: e.g. cpuser_sensordb
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sensordb
DB_USER=sensoruser
DB_PASS=YourStrongPasswordHere
DB_CHARSET=utf8mb4

# Security Secrets (Must be random, unguessable strings in production)
# Minimum 32 characters
SESSION_SECRET=c2Vuc29yLXBsYXRmb3JtLXNlY3VyZS1zZXNzaW9uLWtleS0yMDI2
SESSION_TTL_SECONDS=28800

# File Upload Settings
MAX_FILE_SIZE_MB=100
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=storage/uploads
CONFIG_DIR=storage/configs

# Default Seed Admin (Used during initial migration/seeding only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
